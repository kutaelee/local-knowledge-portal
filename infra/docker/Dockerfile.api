FROM ghcr.io/astral-sh/uv:0.11.30 AS uv
FROM python:3.13.14-slim-trixie
COPY --from=uv /uv /uvx /bin/
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project
COPY alembic.ini ./
COPY db ./db
COPY services ./services
RUN uv sync --frozen --no-dev
ENV PATH="/app/.venv/bin:$PATH" PYTHONPATH="/app/services/api:/app/services/indexer"
CMD ["uvicorn", "lkp.main:app", "--host", "0.0.0.0", "--port", "8010"]
