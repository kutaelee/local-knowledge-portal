LKP_EMBEDDING_PROVIDER=ollama
LKP_EMBEDDING_MODEL=qwen3-embedding:0.6b
LKP_EMBEDDING_MAX_CHUNKS_PER_DOCUMENT=128
LKP_EMBEDDING_MAX_CHARS_PER_DOCUMENT=250000
LKP_REPOSITORY_EMBEDDING_MODE=docs_only
LKP_PIPELINE_VERSION=1.2.0
LKP_WORKER_JOB_COOLDOWN_SECONDS=1
