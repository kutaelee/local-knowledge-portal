REPO_ANALYSIS_MODEL_MAX_CONTEXT=32768
REPO_ANALYSIS_MODEL_MAX_OUTPUT=2048
REPO_ANALYSIS_MODEL_MAX_CONCURRENCY=1
REPO_ANALYSIS_MODEL_QUANTIZATION=
REPO_ANALYSIS_MODEL_PROMPT_VERSION=repo-analysis-v2-evidence-excerpts
REPO_ANALYSIS_MODEL_INCLUDE_SOURCE_EXCERPTS=false
REPO_ANALYSIS_MODEL_MAX_SOURCE_CHARS=80000

# Optional vLLM repository-analysis runtime. Reuse the workstation runtime and
# the canonical shared model; do not install another vLLM or copy model weights.
# Keep the provider disabled until the MTP-1 qualification passes under gpuq.
LKP_HF_MODEL_ROOT=/mnt/e/AI/Models/HuggingFace
LKP_REPOSITORY_VLLM_MODEL_FILE=/mnt/e/AI/Models/HuggingFace/hub/local-shared-models/unsloth_Qwen3.6-27B-MTP-GGUF/Qwen3.6-27B-Q4_K_M.gguf
LKP_REPOSITORY_VLLM_CONFIG_PATH=/mnt/e/AI/Models/HuggingFace/hub/models--Qwen--Qwen3.6-27B/snapshots/6a9e13bd6fc8f0983b9b99948120bc37f49c13e9
LKP_REPOSITORY_VLLM_RUNTIME=/home/YOUR_USER/.local/share/local-voice-agent/runtimes/vllm-0.25.1
LKP_REPOSITORY_VLLM_PORT=18000
LKP_REPOSITORY_VLLM_MAX_MODEL_LEN=16384
LKP_REPOSITORY_VLLM_GPU_MEMORY_UTILIZATION=0.90
LKP_REPOSITORY_VLLM_MAX_NUM_BATCHED_TOKENS=512
# Optional exact KV cache bytes. When set, vLLM ignores GPU utilization and
# uses this bounded cache reservation; leave empty until qualification reports
# the measured safe value for the current runtime/model combination.
LKP_REPOSITORY_VLLM_KV_CACHE_MEMORY_BYTES=
